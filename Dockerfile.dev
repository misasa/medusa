FROM ruby:2.7.2

ARG BUNDLER_VERSION="2.2.8"
ARG UID=1000
ARG GID=1000

# Fix Debian Buster repositories (archived)
RUN sed -i 's|http://deb.debian.org|http://archive.debian.org|g' /etc/apt/sources.list && \
    sed -i 's|http://security.debian.org|http://archive.debian.org|g' /etc/apt/sources.list && \
    sed -i '/buster-updates/d' /etc/apt/sources.list

# Install system dependencies
RUN apt-get update -qq && \
    apt-get install -y \
      build-essential \
      postgresql-client \
      libpq-dev \
      nodejs \
      ghostscript \
      imagemagick \
      curl && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install Yarn from official repository (not the cmdtest package!)
RUN curl -sS https://dl.yarnpkg.com/debian/pubkey.gpg | apt-key add - && \
    echo "deb https://dl.yarnpkg.com/debian/ stable main" | tee /etc/apt/sources.list.d/yarn.list && \
    apt-get update && \
    apt-get install -y yarn && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Create user
RUN groupadd -g ${GID} medusa || true
RUN useradd -m --home-dir /medusa -u ${UID} -g ${GID} medusa || true

USER medusa
WORKDIR /medusa

# Install bundler
RUN gem install bundler --version ${BUNDLER_VERSION}

# Copy Gemfile
COPY --chown=medusa:medusa Gemfile Gemfile.lock /medusa/
RUN bundle config set --local path 'vendor/bundler' && \
    bundle install

# Copy package.json
COPY --chown=medusa:medusa package.json yarn.lock /medusa/
RUN yarn install

ENV PATH="/medusa/bin:${PATH}"

CMD ["bundle", "exec", "rails", "server", "-b", "0.0.0.0"]
